class MultimodalMRIDataset(Dataset):
    def __init__(
        self,
        df: pd.DataFrame,
        clinical_cols: List[str],
        xgb_probs: np.ndarray,
        clinical_present_mask: np.ndarray,
        transform=None
    ):
        self.df = df.reset_index(drop=True)
        self.transform = transform
        self.xgb_probs = xgb_probs
        self.clin_mask = clinical_present_mask.astype(np.float32)
        self.clinical_cols = clinical_cols

    def __len__(self):
        return len(self.df)

    def __getitem__(self, idx):
        row = self.df.iloc[idx]

        try:
            npy_data = np.load(row["path"])
            img_tensor = torch.from_numpy(npy_data).float().unsqueeze(1)

            if self.transform:
                img_tensor = self.transform(img_tensor)

            img_tensor = img_tensor.repeat(1, 3, 1, 1)
        except Exception:
            img_tensor = torch.zeros(9, 3, IMG_SIZE, IMG_SIZE, dtype=torch.float32)

        probs = (
            self.xgb_probs[idx]
            if self.xgb_probs is not None
            else np.full((NUM_CLASSES,), np.nan, dtype=np.float32)
        )
        mask = np.array([1.0], dtype=np.float32) if self.clin_mask[idx] else np.array([0.0], dtype=np.float32)
        label = torch.tensor(row["label"], dtype=torch.long)

        probs_tensor = torch.from_numpy(np.array(probs, dtype=np.float32))
        mask_tensor = torch.from_numpy(mask)

        return img_tensor, probs_tensor, mask_tensor, label

