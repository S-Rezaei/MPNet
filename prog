def get_oof_clinical_predictions(
    train_val_df: pd.DataFrame,
    test_df: pd.DataFrame,
    clinical_cols: List[str],
    label_col: str = "label",
    n_splits: int = 5,
    random_state: int = 42
) -> Tuple[np.ndarray, np.ndarray, np.ndarray, np.ndarray, XGBClassifier]:
    train_val_probs = np.full((len(train_val_df), NUM_CLASSES), np.nan, dtype=np.float32)
    train_val_mask = train_val_df[clinical_cols].notna().any(axis=1).values

    sgkf_inner = StratifiedGroupKFold(n_splits=n_splits, shuffle=True, random_state=random_state)
    X_inner = np.zeros(len(train_val_df))
    y_inner = train_val_df[label_col].values
    groups_inner = train_val_df["PTID"].values

    for train_idx, val_idx in sgkf_inner.split(X_inner, y_inner, groups_inner):
        fold_train = train_val_df.iloc[train_idx]
        fold_val = train_val_df.iloc[val_idx]

        fold_train_mask = fold_train[clinical_cols].notna().any(axis=1).values
        fold_val_mask = fold_val[clinical_cols].notna().any(axis=1).values

        if fold_train_mask.sum() == 0 or fold_val_mask.sum() == 0:
            continue

        X_tr = fold_train.loc[fold_train_mask, clinical_cols].values
        y_tr = fold_train.loc[fold_train_mask, label_col].values
        X_va = fold_val.loc[fold_val_mask, clinical_cols].values

        xgb_inner = XGBClassifier(
            objective="binary:logistic",
            eval_metric="logloss",
            random_state=random_state,
            n_jobs=4,
            missing=np.nan
        )
        xgb_inner.fit(X_tr, y_tr)

        actual_val_indices = np.where(fold_val_mask)[0]
        val_df_global_indices = fold_val.index[actual_val_indices]
        train_val_probs[val_df_global_indices] = xgb_inner.predict_proba(X_va)

    xgb_final = XGBClassifier(
        objective="binary:logistic",
        eval_metric="logloss",
        random_state=random_state,
        n_jobs=4,
        missing=np.nan
    )

    full_train_mask = train_val_df[clinical_cols].notna().any(axis=1).values
    if full_train_mask.sum() > 0:
        xgb_final.fit(
            train_val_df.loc[full_train_mask, clinical_cols].values,
            train_val_df.loc[full_train_mask, label_col].values
        )

    test_probs = np.full((len(test_df), NUM_CLASSES), np.nan, dtype=np.float32)
    test_mask = test_df[clinical_cols].notna().any(axis=1).values
    if test_mask.sum() > 0:
        test_probs[test_mask] = xgb_final.predict_proba(
            test_df.loc[test_mask, clinical_cols].values
        )

    return train_val_probs, train_val_mask, test_probs, test_mask, xgb_final

