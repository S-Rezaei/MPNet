# 9-Slice Tensor Transforms
# -----------------------------
class NineSliceTransform:
    def __init__(self, is_training=True, img_size=224):
        self.is_training = is_training
        self.img_size = img_size

    def __call__(self, tensor: torch.Tensor) -> torch.Tensor:
        tensor = F.interpolate(
            tensor,
            size=(self.img_size, self.img_size),
            mode="bilinear",
            align_corners=False
        )

        if self.is_training:
            angle = random.uniform(-5, 5)
            tensor = self._rotate_tensor(tensor, angle)

            tx = random.uniform(-0.02, 0.02) * self.img_size
            ty = random.uniform(-0.02, 0.02) * self.img_size
            tensor = self._translate_tensor(tensor, tx, ty)

        for slice_idx in range(tensor.shape[0]):
            mean = tensor[slice_idx].mean()
            std = tensor[slice_idx].std() + 1e-8
            tensor[slice_idx] = (tensor[slice_idx] - mean) / std

        return tensor

    def _rotate_tensor(self, tensor: torch.Tensor, angle: float) -> torch.Tensor:
        alpha = angle * np.pi / 180.0
        theta = torch.tensor(
            [
                [np.cos(alpha), -np.sin(alpha), 0],
                [np.sin(alpha),  np.cos(alpha), 0]
            ],
            dtype=torch.float32
        ).unsqueeze(0).repeat(tensor.size(0), 1, 1)

        theta = theta.to(tensor.device)
        grid = F.affine_grid(theta, tensor.size(), align_corners=False)
        return F.grid_sample(tensor, grid, align_corners=False)

    def _translate_tensor(self, tensor: torch.Tensor, tx: float, ty: float) -> torch.Tensor:
        theta = torch.tensor(
            [
                [1, 0, tx / (self.img_size / 2)],
                [0, 1, ty / (self.img_size / 2)]
            ],
            dtype=torch.float32
        ).unsqueeze(0).repeat(tensor.size(0), 1, 1)

        theta = theta.to(tensor.device)
        grid = F.affine_grid(theta, tensor.size(), align_corners=False)
        return F.grid_sample(tensor, grid, align_corners=False)

