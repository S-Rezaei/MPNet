def normalize_text(value):
    if pd.isna(value):
        return ""
    return str(value).strip().replace('"', "").replace("'", "")

def normalize_filename(name):
    return os.path.basename(normalize_text(name))

def remove_known_extension(name):
    name = normalize_filename(name)
    root, ext = os.path.splitext(name)
    if ext.lower() in VALID_EXTENSIONS or ext.lower() in (".png", ".jpg", ".jpeg"):
        return root
    return name

def normalize_ptid(ptid):
    text = normalize_text(ptid)
    match = PTID_PATTERN.search(text)
    return match.group(0) if match else ""

def normalize_imageid(imageid_ext):
    text = normalize_text(imageid_ext)
    if not text:
        return ""
    if text.endswith(".0"):
        text = text[:-2]
    match = re.search(r"I?(\d+)", text, flags=re.IGNORECASE)
    return match.group(1) if match else ""

def normalize_label(value):
    if pd.isna(value):
        return None
    text = str(value).strip()
    if text.endswith(".0"):
        text = text[:-2]
    mapped = LABEL_MAP.get(text, text)
    if mapped in CLASS_TO_IDX:
        return mapped
    return None

def extract_ptid_from_name(name):
    text = normalize_filename(name)
    match = PTID_PATTERN.search(text)
    return match.group(0) if match else ""

def extract_imageid_from_name(name):
    text = normalize_filename(name)
    match = IMAGEID_PATTERN.search(text)
    return match.group(1) if match else ""

def resolve_row_ptid(row):
    ptid = normalize_ptid(row.get("PTID", ""))
    if ptid:
        return ptid
    return extract_ptid_from_name(row.get("mci_output_npy", ""))

def resolve_row_imageid(row):
    imageid = normalize_imageid(row.get("IMAGEID_ext", ""))
    if imageid:
        return imageid
    return extract_imageid_from_name(row.get("mci_output_npy", ""))

def parse_moca_status(val):
    if pd.isna(val):
        return np.nan
    text = str(val).strip()
    if not text:
        return np.nan
    low = text.lower()
    if "imputed" in low:
        m = re.search(r"(\d+)\s+prior", low)
        if m:
            return float(m.group(1))
        return 1.0
    return 0.0 
    
def infer_file_name_type(file_name):
    base = normalize_filename(file_name)
    if re.fullmatch(r"\d{3}_S_\d{4}_I\d+.*", base, flags=re.IGNORECASE):
        return "short_ptid_imageid"
    if base.upper().startswith("ADNI_") and PTID_PATTERN.search(base) and IMAGEID_PATTERN.search(base):
        return "long_adni_name"
    return "unknown"

def collect_all_images(data_dir):
    all_paths = []
    for root_dir, _, files in os.walk(data_dir):
        for file_name in files:
            if file_name.lower().endswith(VALID_EXTENSIONS):
                all_paths.append(os.path.join(root_dir, file_name))
    return all_paths

def build_image_indices(data_dir):
    all_paths = collect_all_images(data_dir)
    by_exact_filename = {}
    by_stem_filename = {}
    by_ptid = {}
    by_ptid_imageid = {}

    for path in all_paths:
        base = os.path.basename(path)
        base_norm = normalize_filename(base)
        stem_norm = remove_known_extension(base)
        ptid = extract_ptid_from_name(base)
        imageid = extract_imageid_from_name(base)

        by_exact_filename.setdefault(base_norm, []).append(path)
        by_stem_filename.setdefault(stem_norm, []).append(path)
        if ptid:
            by_ptid.setdefault(ptid, []).append(path)
        if ptid and imageid:
            by_ptid_imageid.setdefault((ptid, imageid), []).append(path)

    return {
        "by_exact_filename": by_exact_filename,
        "by_stem_filename": by_stem_filename,
        "by_ptid": by_ptid,
        "by_ptid_imageid": by_ptid_imageid,
    }

def choose_best_match(candidates, ptid="", imageid=""):
    if not candidates:
        return None
    if len(candidates) == 1:
        return candidates[0]

    if ptid:
        folder_matches = [
            path for path in candidates
            if os.path.basename(os.path.dirname(path)) == ptid
        ]
        if len(folder_matches) == 1:
            return folder_matches[0]
        if folder_matches:
            candidates = folder_matches

    if imageid:
        token = f"I{imageid}"
        image_matches = [
            path for path in candidates
            if token.lower() in os.path.basename(path).lower()
        ]
        if len(image_matches) == 1:
            return image_matches[0]
        if image_matches:
            candidates = image_matches

    return candidates[0]

def find_image_path(row, indices):
    file_name = row.get("mci_output_npy", "")
    file_name_stem = remove_known_extension(file_name)
    file_name_norm = file_name_stem + ".npy"

    ptid = resolve_row_ptid(row)
    imageid = resolve_row_imageid(row)

    exact_matches = indices["by_exact_filename"].get(file_name_norm, [])
    best = choose_best_match(exact_matches, ptid=ptid, imageid=imageid)
    if best is not None:
        return best

    stem_matches = indices["by_stem_filename"].get(file_name_stem, [])
    best = choose_best_match(stem_matches, ptid=ptid, imageid=imageid)
    if best is not None:
        return best

    if ptid and imageid:
        pair_matches = indices["by_ptid_imageid"].get((ptid, imageid), [])
        best = choose_best_match(pair_matches, ptid=ptid, imageid=imageid)
        if best is not None:
            return best

    if ptid:
        ptid_matches = indices["by_ptid"].get(ptid, [])
        if imageid:
            token = f"I{imageid}"
            filtered = [
                path for path in ptid_matches
                if token.lower() in os.path.basename(path).lower()
            ]
            best = choose_best_match(filtered, ptid=ptid, imageid=imageid)
            if best is not None:
                return best
    return None

def clean_biomarker(val):
    if pd.isna(val):
        return np.nan
    if isinstance(val, str):
        cleaned = re.sub(r"[<>\s,]", "", val)
        try:
            return float(cleaned)
        except ValueError:
            return np.nan
    return float(val)

def preprocess_clinical_data(df: pd.DataFrame, clinical_cols: List[str]) -> pd.DataFrame:
    df = df.copy()
    missing_tokens = ["", " ", "NA", "N/A", "na", "n/a", "null", "None", "none", "missing"]

    for col in clinical_cols:
        if col not in df.columns:
            df[col] = np.nan
    if MOCA_STATUS_COL in df.columns:
        df[MOCA_STATUS_CODE] = df[MOCA_STATUS_COL].apply(parse_moca_status)
    df[clinical_cols] = df[clinical_cols].replace(missing_tokens, np.nan)

    for col in clinical_cols:
        if col == "mci_gender":
            df[col] = df[col].astype(str).str.strip().str.upper().map(
                {"F": 0, "FEMALE": 0, "0": 0, "M": 1, "MALE": 1, "1": 1}
            ).fillna(np.nan)
        else:
            df[col] = df[col].apply(clean_biomarker)

    return df

def build_samples_from_csv(csv_path, data_dir, label_column):
    df = pd.read_csv(csv_path)

    required_columns = ["mci_output_npy", label_column]
    missing_columns = [col for col in required_columns if col not in df.columns]
    if missing_columns:
        raise ValueError(f"Missing columns in CSV: {missing_columns}")

    df = preprocess_clinical_data(df, CLINICAL_COLS)

    if "PTID" not in df.columns:
        df["PTID"] = ""
    if "IMAGEID_ext" not in df.columns:
        df["IMAGEID_ext"] = ""

    df["resolved_ptid"] = df.apply(resolve_row_ptid, axis=1)
    df["resolved_imageid"] = df.apply(resolve_row_imageid, axis=1)
    df["label_name"] = df[label_column].apply(normalize_label)
    df["label_idx"] = df["label_name"].apply(lambda x: CLASS_TO_IDX.get(x, -1))

    indices = build_image_indices(data_dir)
    samples = []
    missing_image_count = 0

    for _, row in df.iterrows():
        if row["label_idx"] == -1:
            continue

        image_path = find_image_path(row, indices)
        if image_path is None:
            missing_image_count += 1
            continue

        ptid = row["resolved_ptid"]
        if not ptid:
            ptid = extract_ptid_from_name(os.path.basename(image_path))

        imageid = row["resolved_imageid"]
        if not imageid:
            imageid = extract_imageid_from_name(os.path.basename(image_path))

        sample_dict = {
            "path": image_path,
            "label": int(row["label_idx"]),
            "PTID": ptid,
            "IMAGEID": imageid,
            "source_file_name": normalize_filename(row["mci_output_npy"]),
            "file_type": infer_file_name_type(row["mci_output_npy"]),
        }

        for col in CLINICAL_COLS:
            sample_dict[col] = row[col]

        samples.append(sample_dict)

    samples_df = pd.DataFrame(samples).drop_duplicates(subset=["path", "label"])
    print(f"Matched samples: {len(samples_df)}")
    print(f"Rows skipped only because image not found: {missing_image_count}")
    return samples_df

